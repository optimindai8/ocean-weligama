# Copy to .env and fill in. Never commit the real .env file.

# ---------------------------------------------------------------- Server
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
# Number of reverse proxies in front of this app (nginx, Cloudflare, ... = 1).
# Needed so the real visitor IP is used for rate limiting. Use 0 if exposed directly.
TRUST_PROXY=1

# ---------------------------------------------------------------- Storage
DATABASE_PATH=./data/analytics.db
# Raw events older than this many days are deleted automatically.
RETENTION_DAYS=395

# ---------------------------------------------------------------- Security
# Exact origin(s) of the hotel website, comma separated, no trailing slash.
ALLOWED_ORIGINS=https://www.yourhotel.com
# At least 32 random characters. Generate one with:
#   node -p "require('node:crypto').randomBytes(48).toString('base64url')"
APP_SECRET=
ADMIN_USERNAME=admin
# Generate with:  npm run hash-password
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=8
# Max tracking requests per IP per minute (guests on one hotel Wi-Fi share an IP, so keep this generous).
COLLECT_RATE_LIMIT_PER_MINUTE=600

# ---------------------------------------------------------------- Reporting
# Timezone used for "today" and daily charts, as minutes from UTC. Sri Lanka (UTC+05:30) = 330.
REPORT_UTC_OFFSET_MINUTES=330
# Header set by your CDN with the visitor's 2-letter country code.
# Cloudflare: cf-ipcountry | Vercel: x-vercel-ip-country | CloudFront: cloudfront-viewer-country
# Leave empty to disable country reporting.
COUNTRY_HEADER=cf-ipcountry
