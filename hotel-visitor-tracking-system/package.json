{
  "name": "hotel-visitor-tracking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight, privacy-conscious visitor tracking with an admin analytics dashboard for a hotel website. TypeScript, Clean Architecture.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
